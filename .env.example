# Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Telegram bot (create via @BotFather, then message the bot once and check
# https://api.telegram.org/bot<token>/getUpdates to find your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Safety: while true, the retention sweep only REPORTS what it would back up
# and delete via Telegram - it does not touch Drive or Gmail. Flip to false
# only after you've watched a few dry-run reports and trust them.
DRY_RUN=true

# Per-category retention: "category:days_old,category:days_old,...".
# A category NOT listed here is kept forever regardless of age (currently:
# important, personal, receipts, statements, e_mandate). 0 = eligible on the
# very next sweep run (Gmail's `before:` search is date-granular, not
# instantaneous - see docs/ARCHITECTURE.md section 6).
RETENTION_POLICY=promotions:0,social:0,newsletters:365,other:0

# Scheduling
SORT_INTERVAL_MINUTES=20
SWEEP_DAY_OF_WEEK=sun
SWEEP_HOUR=9

# Liveness heartbeat for Dockerfile's HEALTHCHECK - defaults are fine for
# almost everyone, only override if you know why.
# HEARTBEAT_PATH=data/heartbeat
# HEARTBEAT_INTERVAL_MINUTES=2

# Approval expiry
APPROVAL_TTL_HOURS=48

# Drive backup destination: EmailCleanerBackups/<account>/<year>/
DRIVE_BACKUP_ROOT_FOLDER=EmailCleanerBackups

# json (default, for unattended/server use) or text (easier to read while developing locally)
LOG_FORMAT=json

# Paths (defaults are fine for local use)
DB_PATH=data/app.sqlite3
CHECKPOINT_DB_PATH=data/checkpoints.sqlite3
GOOGLE_CLIENT_SECRET_PATH=secrets/client_secret.json
TOKENS_DIR=secrets/tokens
